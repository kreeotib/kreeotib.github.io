                                p.title.title--base.title--white.title--center Спасибо за заявку
                                p.text.text--base.text--white.title--center Мы скоро сввяжемся с вами
        .popup.popup-enter
            .popup__wrapper.popup__wrapper--container
                .popup__overlay
                .popup__content
                    form(action="mail.php").modal.form
                        span.modal__close.popup-close
                        .modal__wrapper
