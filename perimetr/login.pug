-
    const nav = [
        {title: 'о проекте', href: '#about'},
        {title: 'программа', href: '#program'},
        {title: 'локация 2026', href: '#location'},
        {title: 'цены', href: '#pricing'},
        {title: 'участие', href: '#contact'},
        {title: 'faq', href: '#faq'}
    ]

doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

        <!-- Favicons -->
        <link rel="apple-touch-icon" sizes="180x180" href="assets/favicon/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon/favicon-16x16.png">
        <link rel="shortcut icon" href="assets/favicon/favicon.ico">
        <link rel="manifest" href="assets/favicon/site.webmanifest">

        <!-- OG / Social -->
        <meta property="og:image" content="https://prm.779.su/assets/images/og.webp">
        <meta property="og:image:width" content="512">
        <meta property="og:image:height" content="512">
        <meta property="og:image:type" content="image/png">

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary">
        <meta name="twitter:image" content="https://prm.779.su/assets/images/og.webp">

        link(rel="stylesheet" href="assets/styles/css/reset.css")
        link(rel="stylesheet" href="assets/styles/css/index.css")
        title Периметр
    body
        .popup.popup-enter
            .popup__wrapper.popup__wrapper--container
                .popup__overlay
                .popup__content
                    form.modal.form
                        span.modal__close.popup-close
                        .modal__wrapper
                            .form__wrapper
                                p.title.title--base.title--white Войти в Периметр управления
                                p.text.text--base.text--white.form__text Разберем процесс и адаптируем систему под ваши задачи
                                .form-grid
                                    .form-grid__item
                                        label.input
                                            input.input__item(type="text" placeholder="Имя")
                                    .form-grid__item
                                        label.input
                                            input.input__item(type="text" placeholder="Название компании")
                                    .form-grid__item
                                        label.input
                                            input.input__item(type="text" placeholder="Телефон" class="js-phone-mask" pattern="\+7\s\d{3}\s\d{3}\s\d{2}\s\d{2}")
                                    .form-grid__item
                                        label.input
                                            input.input__item(type="text" placeholder="Email")
                                    .form-grid__item.form-grid__item--full
                                        button(type="submit").button.button--full.button--big.button--white
                                            span.button__text Отправить
                                    .form-grid__item.form-grid__item--full
                                        label.checkbox
                                            input.checkbox__input(type="checkbox" required)
                                            span.checkbox__checkmark
                                                svg.icon
                                                    use(xlink:href="assets/images/sprite.svg#check")
                                            span.checkbox__text Вы&nbsp;даете согласие на&nbsp;обработку персональных данных, принимаете условия #[a(href="policy-user.html") Политики конфиденциальности] и&nbsp;#[a(href="user-agre.html") Пользовательского соглашения]
        .cookie
            .cookie__wrapper
                p.cookie__text Для оптимизации работы сайта мы используем #[a(href="#") файлы cookie]. Продолжая пользоваться нашим ресурсом, вы даете согласие на их применение
                button.button.button--base.button--accent.button--full.cookie__button Отлично
        .page-wrapper
            header.header.header--login
                .header__wrapper
                    .container
                        .header__row
                            a(href="/").logo.header__logo.image
                                svg.logo__img.image__item
                                    use(xlink:href="assets/images/sprite.svg#logo")

            main.content
                .login
                    .login__bg.image
                        img(src="assets/images/login.webp" draggable="false" ondragstart="return false;").image__item
                    .login__content.form
                        .form__wrapper
                            p.title.title--base.title--white Войти в Периметр управления
                            p.text.text--base.text--white.form__text Разберем процесс и адаптируем систему под ваши задачи
                            .form-grid
                                .form-grid__item.form-grid__item--full
                                    label.input
                                        input.input__item(type="text" placeholder="Введите логин")
                                .form-grid__item.form-grid__item--full
                                    label.input
                                        input.input__item(type="password" placeholder="Введите пароль")
                                .form-grid__item.form-grid__item--full
                                    button(type="submit").button.button--full.button--big.button--white
                                        span.button__text Отправить
                                .form-grid__item.form-grid__item--full
                                    p.text.text--small.text--white.text--center Забыли пароль?
        script(src="assets/scripts/imask.js")
        script(src="assets/scripts/index.js")